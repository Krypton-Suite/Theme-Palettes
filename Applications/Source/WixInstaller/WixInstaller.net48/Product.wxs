<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
	<!-- do not change this ever !-->
	<?define UpgradeCode = "38FC3474-F06B-4C57-8869-15B23AEBFB10" ?>

	<?define Version = "85.24.10.288" ?>
	<!--"!(bind.FileVersion.Krypton.Toolkit.dll)" -->

	<?define ProductName = "Krypton Toolkit Palette Net48 Apps"?>

	<Package Version="$(var.Version)" UpgradeCode="$(var.UpgradeCode)" Name="$(var.ProductName)" Language="1033" Manufacturer="https://github.com/Krypton-Suite" Scope="perUser">
		<SummaryInformation Keywords="Installer" Description="$(var.ProductName)" />

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<!-- +++++++++++++++++++++++++++ Advertised shortcuts will not produce ICE errors, but will be converted to non-advertised shortcuts when installed -->
		<Property Id="DISABLEADVTSHORTCUTS" Value="1" />

		<!-- This property enables verbose logging in WiX custom actions. It writes extra entries to the MSI log. -->
		<Property Id="LOGVERBOSE" Value="1" />

		<PropertyRef Id="NETFRAMEWORK45" />
		<!-- Pull in the checks for .Net 4.x-->
		<PropertyRef Id="WIX_IS_NETFRAMEWORK_480_OR_LATER_INSTALLED" />

		<!-- Taken from https://github.com/wixtoolset/issues/issues/5977 -->
		<Launch Condition="Installed OR WIX_IS_NETFRAMEWORK_480_OR_LATER_INSTALLED" Message="[ProductName] Requires .NET Framework 4.8.0 or later to be installed. Please install from the `Pre-Reqs` folder." />

		<InstallExecuteSequence>
			<!-- This disables removing shortcuts except on uninstall. -->
			<RemoveShortcuts Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />
		</InstallExecuteSequence>

		<!--Allow 7z / zip compression to squeeze this tighter 
        high = 6.9MB -> 6.4mb  as 7z
        none = 24.9 -> 2.8mb as 7z        -->
		<Media Id="1" Cabinet="Setup.cab" EmbedCab="yes" CompressionLevel="high" />

		<DirectoryRef Id="ProgramMenuDir">
			<Component Id="ProgramMenuDir1" Guid="11234567-7E98-44CE-B049-C477CC0A2B01">
				<Shortcut Id="KryptonToolkitPalette_Shortcut"
                          Name="Krypton Toolkit Palette Designer"
                          Description="Krypton Toolkit Palette Designer"
                          Target="[KryptonToolkitPaletteDir]\Palette Designer.exe"
                          WorkingDirectory="KryptonToolkitPaletteDir" IconIndex="0" />
				<RemoveFolder Id="ProgramMenuDir" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\Microsoft\KryptonToolkitPalette_Shortcut" Name="installed" Type="integer" Value="1" KeyPath="yes" />
			</Component>
          <Component Id="ProgramMenuDir2" Guid="11234567-7E98-44CE-B049-C477CC0A2B02">
            <Shortcut Id="KryptonToolkitPaletteU_Shortcut"
                      Name="Krypton Toolkit Palette Upgrade Tool"
                      Description="Krypton Toolkit Palette Upgrade Tool"
                      Target="[KryptonToolkitPaletteDir]\Palette Upgrade Tool.exe"
                      WorkingDirectory="KryptonToolkitPaletteDir" IconIndex="0" />
            <!--<RemoveFolder Id="ProgramMenuDir" On="uninstall" />-->
            <RegistryValue Root="HKCU" Key="Software\Microsoft\KryptonToolkitPaletteU_Shortcut" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
		</DirectoryRef>

		<Feature Id="ProductFeature" Title="KryptonToolkitPalette_Setup" Level="1">
			<ComponentGroupRef Id="KryptonToolkitPalette" />
			<ComponentGroupRef Id="BasePath48" />
            <ComponentRef Id="ProgramMenuDir1" />
			<ComponentRef Id="ProgramMenuDir2" />
		</Feature>

		<!-- Get the install to skip a few steps -->
		<Property Id="WIXUI_INSTALLDIR" Value="KryptonToolkitPaletteDir" />
		<ui:WixUI Id="WixUI_InstallDir" />

		<UIRef Id="WixUI_ErrorProgressText" />



		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="ProgramMenuDir" Name="Krypton Toolkit Palette" />
		</StandardDirectory>
		<StandardDirectory Id="CommonAppDataFolder">
			<Directory Id="KryptonToolkitPaletteDir" Name="Krypton Toolkit Palette net48" />
		</StandardDirectory>
	</Package>

</Wix>
